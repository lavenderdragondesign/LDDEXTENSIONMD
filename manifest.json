{
  "manifest_version": 3,
  "name": "LDD Tools",
  "version": "1.8.357",
  "description": "LDD Tools for MyDesigns with Wall Art Exporter integrated into the native Tools page.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://mydesigns.io/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://raw.githubusercontent.com/lavenderdragondesign/lddscoutaistyles/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mydesigns.io/app*"
      ],
      "exclude_matches": [
        "https://mydesigns.io/orders*",
        "https://mydesigns.io/app/orders*"
      ],
      "js": [
        "core/chart-theme.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "css": []
    },
    {
      "run_at": "document_idle",
      "matches": [
        "https://mydesigns.io/app*"
      ],
      "exclude_matches": [
        "https://mydesigns.io/orders*",
        "https://mydesigns.io/app/orders*"
      ],
      "js": [
        "core/content.js",
        "core/vault-tools.js",
        "core/pdf-library.js",
        "core/pdf-lib/pdf.min.js",
        "scout/scout-pong.js",
        "scout/content.js",
        "wallart/md-launcher.js"
      ],
      "css": [
        "core/content.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "scout/style-json-reader.js",
        "scout/chatgpt-bridge.js",
        "core/pdf-lib/pdf.min.js",
        "promptqueue/pdf-parse.js",
        "promptqueue/content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "promptqueue/styles.css"
      ]
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "scout/style-json-reader.js",
        "scout/claude-bridge.js"
      ],
      "run_at": "document_idle",
      "css": []
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LDD Tools",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/icon128.png",
        "assets/icons/icon16.png",
        "assets/icons/icon32.png",
        "assets/icons/icon48.png",
        "scout/pong-worker.js",
        "scout/icons/icon48.png",
        "core/pdf-lib/pdf.min.js",
        "core/pdf-lib/pdf.worker.min.js",
        "wallart/index.html",
        "wallart/app.js",
        "wallart/style.css",
        "wallart/logo.png"
      ],
      "matches": [
        "https://mydesigns.io/*"
      ]
    },
    {
      "resources": [
        "core/pdf-lib/pdf.min.js",
        "core/pdf-lib/pdf.worker.min.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "core/background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}